#!/usr/bin/env bash
# Verification harness for the charms CLI. See ../SKILL.md.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO=$(cd "$SCRIPT_DIR/../../../.." && pwd)
# Cargo writes the built-in `test` profile to target/debug, not target/test.
CHARMS_BIN=${CHARMS_BIN:-"$REPO/target/debug/charms"}

if [[ -f /exec-daemon/tmux.portal.conf ]]; then
  TMUX=(tmux -f /exec-daemon/tmux.portal.conf)
else
  TMUX=(tmux)
fi

die() {
  echo "control-charms: $*" >&2
  exit 1
}

canonical_path() {
  realpath -m -- "$1"
}

# Resolve the path, then require it to be a strict child of root.
# Lexical prefixes accept `root/../../elsewhere`.
require_contained() {
  local path=$1 root=$2 label=$3
  local canon root_canon
  canon=$(canonical_path "$path")
  root_canon=$(canonical_path "$root")
  case "$canon" in
    "$root_canon"/*) ;;
    *) die "$label must stay under ${root_canon}/ (resolved to $canon)" ;;
  esac
  printf '%s\n' "$canon"
}

require_run_id() {
  [[ -n "${CHARMS_VERIFY_RUN_ID:-}" ]] || die "set CHARMS_VERIFY_RUN_ID before launch, doctor, cli, or cleanup"
  [[ "$CHARMS_VERIFY_RUN_ID" =~ ^[A-Za-z0-9._-]+$ ]] || die "CHARMS_VERIFY_RUN_ID must match [A-Za-z0-9._-]+"
  RUN_ID=$CHARMS_VERIFY_RUN_ID
  WORK=$(require_contained "${CHARMS_VERIFY_WORK:-/tmp/charms-verify-work/$RUN_ID}" /tmp/charms-verify-work CHARMS_VERIFY_WORK)
  EVIDENCE=$(require_contained "${CHARMS_VERIFY_EVIDENCE:-/tmp/charms-verify-evidence/$RUN_ID}" /tmp/charms-verify-evidence CHARMS_VERIFY_EVIDENCE)
  STATE=$(require_contained "${CHARMS_VERIFY_STATE:-/tmp/charms-verify-state/$RUN_ID}" /tmp/charms-verify-state CHARMS_VERIFY_STATE)
}

workspace_version() {
  awk '
    $0 ~ /^\[workspace\.package\]/ { in_ws=1; next }
    in_ws && $0 ~ /^\[/ { in_ws=0 }
    in_ws && $0 ~ /^version[[:space:]]*=/ {
      gsub(/"/, "", $3)
      print $3
      exit
    }
  ' "$REPO/Cargo.toml"
}

cmd_launch() {
  require_run_id
  cargo build --profile=test --bin charms --manifest-path "$REPO/Cargo.toml"
  local bin
  bin=$(canonical_path "$CHARMS_BIN")
  [[ -x "$bin" ]] || die "build finished but $bin is not executable"
  mkdir -p "$WORK/out" "$WORK/runners" "$EVIDENCE" "$STATE"
  cat >"$STATE/instance" <<EOF
run_id=$RUN_ID
repo=$REPO
binary=$bin
work=$WORK
evidence=$EVIDENCE
EOF
  echo "launched $bin"
  echo "work $WORK"
  echo "evidence $EVIDENCE"
}

state_field() {
  local key=$1
  sed -n "s/^${key}=//p" "$STATE/instance"
}

cmd_doctor() {
  local override=${1:-}
  require_run_id
  [[ -f "$STATE/instance" ]] || die "no instance for $RUN_ID; run launch first"
  local state_binary state_work state_evidence bin
  state_binary=$(state_field binary)
  state_work=$(state_field work)
  state_evidence=$(state_field evidence)
  if [[ -n "$override" ]]; then
    bin=$override
  else
    bin=$state_binary
  fi
  [[ -n "$bin" && -x "$bin" ]] || die "binary is missing: $bin"
  [[ "$state_work" == "$WORK" && -d "$WORK" ]] || die "work directory is missing: $WORK"
  [[ "$state_evidence" == "$EVIDENCE" && -d "$EVIDENCE" ]] || die "evidence directory is missing: $EVIDENCE"
  case "$WORK" in
    "$REPO"|"$REPO"/*) die "work directory is inside the repo: $WORK" ;;
  esac
  local expected actual
  expected=$(workspace_version)
  [[ -n "$expected" ]] || die "could not read [workspace.package] version from $REPO/Cargo.toml"
  actual=$("$bin" --version)
  [[ "$actual" == "charms $expected" || "$actual" == "charms-prover $expected" ]] || die "version mismatch: binary says '$actual', Cargo.toml says $expected"
  echo "run_id: $RUN_ID"
  echo "repo: $REPO"
  echo "binary: $bin"
  echo "version: $actual"
  echo "work: $WORK"
  echo "evidence: $EVIDENCE"
  echo "ready: yes"
}

append_forwarded_env() {
  local name="$1"
  if [[ -n "${!name:-}" ]]; then
    TMUX_ENV+=(-e "$name=${!name}")
  fi
}

cmd_cli() {
  require_run_id
  local feature="" evidence="cli" timeout=60 cwd="" bin_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --feature)
        feature=$2
        shift 2
        ;;
      --evidence)
        evidence=$2
        shift 2
        ;;
      --timeout)
        timeout=$2
        shift 2
        ;;
      --cwd)
        cwd=$2
        shift 2
        ;;
      --bin)
        bin_override=$2
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        die "unknown flag $1 (use -- before the charms arguments)"
        ;;
    esac
  done
  [[ $# -ge 1 ]] || die "missing charms arguments after --"
  [[ "$evidence" =~ ^[A-Za-z0-9._-]+$ ]] || die "--evidence must match [A-Za-z0-9._-]+"
  [[ "$timeout" =~ ^[0-9]+$ ]] || die "--timeout must be a whole number of seconds"
  local drive_bin
  if [[ -n "$bin_override" ]]; then
    drive_bin=$(canonical_path "$bin_override")
    local repo_canon target_root
    repo_canon=$(canonical_path "$REPO")
    target_root="$repo_canon/target"
    case "$drive_bin" in
      "$target_root"/*) ;;
      *) die "--bin must stay under $target_root (resolved to $drive_bin)" ;;
    esac
    [[ -f "$drive_bin" && -x "$drive_bin" ]] || die "--bin is not an executable file: $drive_bin"
    cmd_doctor "$drive_bin" >/dev/null
  else
    cmd_doctor >/dev/null
    drive_bin=$(state_field binary)
    [[ -n "$drive_bin" && -x "$drive_bin" ]] || die "launch did not record an executable binary"
  fi
  if [[ -z "$cwd" ]]; then
    cwd=$WORK
  else
    [[ -d "$cwd" ]] || die "--cwd is not a directory: $cwd"
    cwd=$(canonical_path "$cwd")
    case "$cwd" in
      "$WORK"|"$WORK"/*) ;;
      *) die "--cwd must stay inside $WORK (resolved to $cwd)" ;;
    esac
  fi

  local session="charms-verify-${RUN_ID}-${evidence}"
  local runner="$WORK/runners/${evidence}.sh"
  local stdout_file="$WORK/out/${evidence}.stdout"
  local stderr_file="$WORK/out/${evidence}.stderr"
  mkdir -p "$WORK/out" "$WORK/runners" "$EVIDENCE"

  {
    echo "#!/bin/bash"
    echo "set +e"
    printf 'cmd=('
    printf '%q ' "$drive_bin" "$@"
    echo ')'
    echo 'printf "COMMAND:"'
    echo 'printf " %q" "${cmd[@]}"'
    echo 'printf "\n"'
    printf '"${cmd[@]}" >%q 2>%q\n' "$stdout_file" "$stderr_file"
    echo 'code=$?'
    echo 'echo "EXIT:$code"'
    echo 'echo "--- stdout ---"'
    echo "cat $(printf '%q' "$stdout_file")"
    echo 'echo "--- stderr ---"'
    echo "cat $(printf '%q' "$stderr_file")"
    echo 'echo "CHARMS_VERIFY_EXIT:$code"'
  } >"$runner"
  chmod +x "$runner"

  echo "$session" >>"$STATE/sessions"
  TMUX_ENV=()
  local forwarded
  for forwarded in CHARMS_PROVE_API_URL APP_SP1_PROVER SPELL_SP1_PROVER NETWORK_PRIVATE_KEY NETWORK_RPC_URL RUST_LOG RUST_LOGGER; do
    append_forwarded_env "$forwarded"
  done

  "${TMUX[@]}" new-session -d "${TMUX_ENV[@]}" -s "$session" -c "$cwd" -- bash --noprofile --norc
  "${TMUX[@]}" set-option -t "$session" remain-on-exit on
  local pane="" ready_deadline=$((SECONDS + 10))
  while (( SECONDS < ready_deadline )); do
    pane=$("${TMUX[@]}" capture-pane -pt "$session" -S -20 || true)
    if [[ -n "$pane" ]]; then
      break
    fi
    sleep 0.1
  done
  "${TMUX[@]}" send-keys -t "$session" "bash $(printf '%q' "$runner")" C-m

  local deadline=$((SECONDS + timeout))
  pane=""
  while (( SECONDS < deadline )); do
    pane=$("${TMUX[@]}" capture-pane -pt "$session" -S -32768 || true)
    if [[ "$pane" == *"CHARMS_VERIFY_EXIT:"* ]]; then
      break
    fi
    sleep 0.2
  done

  if [[ "$pane" != *"CHARMS_VERIFY_EXIT:"* ]]; then
    "${TMUX[@]}" kill-session -t "=$session" 2>/dev/null || true
    [[ -f "$stdout_file" ]] || : >"$stdout_file"
    [[ -f "$stderr_file" ]] || : >"$stderr_file"
    {
      echo "feature: ${feature:-unspecified}"
      echo "run_id: $RUN_ID"
      echo "binary: $drive_bin"
      echo "timed_out: yes"
      printf 'argv:'
      printf ' %q' "$drive_bin" "$@"
      echo
      echo "exit: timeout"
      echo "--- stdout ---"
      cat "$stdout_file"
      echo "--- stderr ---"
      cat "$stderr_file"
    } >"$EVIDENCE/${evidence}.txt"
    printf '%s\n' "$pane" >"$EVIDENCE/${evidence}.pane.txt"
    cp "$stdout_file" "$EVIDENCE/${evidence}.stdout"
    cp "$stderr_file" "$EVIDENCE/${evidence}.stderr"
    printf '%s\n' timeout >"$EVIDENCE/${evidence}.exit"
    echo "control-charms: timed out after ${timeout}s; transcript $EVIDENCE/${evidence}.txt" >&2
    return 1
  fi

  local code
  code=$(printf '%s\n' "$pane" | sed -n 's/^CHARMS_VERIFY_EXIT://p' | tail -1)
  {
    echo "feature: ${feature:-unspecified}"
    echo "run_id: $RUN_ID"
    echo "binary: $drive_bin"
    printf 'argv:'
    printf ' %q' "$drive_bin" "$@"
    echo
    echo "exit: $code"
    echo "--- stdout ---"
    cat "$stdout_file"
    echo "--- stderr ---"
    cat "$stderr_file"
  } >"$EVIDENCE/${evidence}.txt"
  printf '%s\n' "$pane" >"$EVIDENCE/${evidence}.pane.txt"
  cp "$stdout_file" "$EVIDENCE/${evidence}.stdout"
  cp "$stderr_file" "$EVIDENCE/${evidence}.stderr"
  printf '%s\n' "$code" >"$EVIDENCE/${evidence}.exit"

  "${TMUX[@]}" kill-session -t "=$session" || true
  return "$code"
}

cmd_cleanup() {
  require_run_id
  if [[ -f "$STATE/sessions" ]]; then
    local session
    while IFS= read -r session; do
      [[ -n "$session" ]] || continue
      "${TMUX[@]}" kill-session -t "=$session" 2>/dev/null || true
    done <"$STATE/sessions"
  fi
  if [[ -d "$WORK" ]]; then
    rm -rf "$WORK"
  fi
  if [[ -d "$STATE" ]]; then
    rm -rf "$STATE"
  fi
  if [[ -d "$EVIDENCE" ]]; then
    echo "evidence kept at $EVIDENCE"
  else
    echo "no evidence directory at $EVIDENCE"
  fi
}

usage() {
  echo "usage: control-charms launch|doctor|cli|cleanup" >&2
  exit 2
}

[[ $# -ge 1 ]] || usage
case "$1" in
  launch) shift; cmd_launch "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  cli) shift; cmd_cli "$@" ;;
  cleanup) shift; cmd_cleanup "$@" ;;
  *) usage ;;
esac
