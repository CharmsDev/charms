pragma solidity 0.8.37;

import {ICharms} from "../src/interfaces/ICharms.sol";
import {CharmsIds} from "../src/libraries/CharmsIds.sol";
import {SpellCodec} from "../src/libraries/SpellCodec.sol";
import {CharmsTestBase} from "./utils/CharmsTestBase.sol";

contract PlaceholderTest is CharmsTestBase {
    address internal constant CALLER = address(0x1111111111111111111111111111111111111111);
    address internal constant OWNER = address(0x0102030405060708090a0B0c0d0e0f1011121314);
    address internal constant OTHER = address(0x2222222222222222222222222222222222222222);
    address internal constant PROXY = address(0x3333333333333333333333333333333333333333);
    bytes32 internal constant SALT = bytes32(uint256(7));

    bytes internal constant ONE_CBOR =
        hex"a36776657273696f6e0f627478a363696e7380646f75747381a065636f696e7381a266616d6f756e74006464657374940102030405060708090a0b0c0d0e0f1011121314716170705f7075626c69635f696e70757473a0";
    bytes32 internal constant ONE_TX =
        0xfe12fb10d8317475b864e2393961d5aa2af56d0923de9c79ac8bc0eb02f3e7a7;
    bytes32 internal constant ONE_ANCHOR =
        0x07315875c131dc1dff59b5eecd3feba7c4eb34f9c8bac4a22e69acd1d04d63c5;

    function _one() internal pure returns (Spell memory s) {
        s.version = 15;
        s.outs = new Output[](1);
        s.outs[0].owner = OWNER;
    }

    function _two() internal pure returns (Spell memory s) {
        s.version = 15;
        s.outs = new Output[](2);
        s.outs[0].owner = OWNER;
        s.outs[1].owner = OTHER;
    }

    function test_phase1PlaceholderIsAnEmptyUtxo() public {
        _deployPhase1();
        Spell memory s = _one();

        vm.prank(CALLER);
        bytes32 txId = charms.transact(s, SALT, "", new bytes[](0));

        assertEq(txId, _txId(s, CALLER, SALT));
        (uint8 kind, address owner) = _kind(txId, 0);
        assertEq(kind, 0);
        assertEq(owner, OWNER);
        (address storedOwner, bytes memory body) = charms.utxo(UtxoRef(txId, 0));
        assertEq(storedOwner, OWNER);
        assertEq(body.length, 0);
    }

    function test_oneOutputMatchesTheHostRecord() public pure {
        Spell memory s = _one();
        bytes memory cbor = SpellCodec.encode(s);
        bytes32 anchor = keccak256(abi.encode(CALLER, SALT));
        bytes memory data = abi.encodeCall(ICharms.transact, (s, SALT, "", new bytes[](0)));

        assertEq(
            ICharms.transact.selector,
            bytes4(
                keccak256(
                    "transact((uint32,(uint32,bytes32,bytes32)[],bytes[],(bytes32,uint32,bytes32)[],((bytes32,uint32),(uint32,uint64,bytes)[],(bytes32,uint32,bytes32)[])[],(bytes32,uint32)[],(address,(uint32,uint64,bytes)[])[],(uint32,bytes32)[],uint32[]),bytes32,bytes,bytes[])"
                )
            )
        );
        assertEq(cbor, ONE_CBOR);
        assertEq(anchor, ONE_ANCHOR);
        assertEq(CharmsIds.ethTxId(1, PROXY, anchor, cbor), ONE_TX);
        assertEq(
            data,
            hex""
        );
    }

    function test_twoOutputsMatchTheHostRecord() public pure {
        Spell memory s = _two();
        bytes memory cbor = SpellCodec.encode(s);
        bytes32 anchor = keccak256(abi.encode(CALLER, SALT));
        assertEq(
            cbor,
            hex"a36776657273696f6e0f627478a363696e7380646f75747382a0a065636f696e7382a266616d6f756e74006464657374940102030405060708090a0b0c0d0e0f1011121314a266616d6f756e740064646573749418221822182218221822182218221822182218221822182218221822182218221822182218221822716170705f7075626c69635f696e70757473a0"
        );
        assertEq(
            CharmsIds.ethTxId(1, PROXY, anchor, cbor),
            0x1568b0106469209c7aa1b6c36bf9d7613e3843811128524d0887e1ae51bf7150
        );
        assertEq(
            abi.encodeCall(ICharms.transact, (s, SALT, "", new bytes[](0))),
            hex""
        );
    }
}
